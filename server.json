{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.sigpen/mcp",
  "title": "SigPen",
  "description": "Draft, fill in, and prepare documents for e-signature. You approve every send in SigPen.",
  "version": "1.1.0",
  "websiteUrl": "https://www.sigpen.com/ai-assistants",
  "repository": {
    "url": "https://github.com/sigpenhq/sigpen-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://www.sigpen.com/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.sigpen.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your SigPen API key, sent as a Bearer token.",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "A SigPen API key (sp_live_...). Create one at https://www.sigpen.com/developer?tab=ai",
              "isRequired": true,
              "isSecret": true,
              "placeholder": "sp_live_..."
            }
          }
        }
      ]
    }
  ]
}
